# syntax=docker/dockerfile:1

FROM node:22.16.0-bookworm-slim AS build

ENV NODE_ENV=development
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src

RUN npm run build \
    && npm prune --omit=dev --ignore-scripts \
    && npm cache clean --force

FROM node:22.16.0-bookworm-slim AS runtime

ENV NODE_ENV=production \
    HOME=/home/godprompt
WORKDIR /app

RUN groupadd --system --gid 10001 godprompt \
    && useradd --system --uid 10001 --gid godprompt --home-dir "$HOME" --create-home --shell /usr/sbin/nologin godprompt

COPY --from=build --chown=10001:10001 /app/package.json /app/package-lock.json ./
COPY --from=build --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/dist ./dist

USER 10001:10001

ENTRYPOINT ["node", "dist/stdio.js"]
